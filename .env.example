# The real production domain (e.g. https://moveandinvest.com), no trailing
# slash. Single source of truth for canonicals, hreflang, sitemap and JSON-LD
# URLs — leave unset until launch. The site is only indexable when this AND a
# Vercel production deployment (VERCEL_ENV=production, set automatically) are
# both true; local dev and preview deployments are always noindex regardless.
# Any *.vercel.app host is ALSO always noindex as a separate hard rule
# (src/proxy.ts), even on the production deployment.
NEXT_PUBLIC_SITE_URL=

# --- Added in step 2 (Sanity) ------------------------------------------------

# Sanity project connection (public — exposed to the browser for the embedded
# Studio at /studio and for client-side reads).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only token with at least read access. Never exposed to the browser.
SANITY_API_READ_TOKEN=

# Server-only, Viewer-scoped token dedicated to draft mode. Long-lived, but
# keep it Viewer-only — it must never be able to write.
SANITY_API_PREVIEW_TOKEN=

# Shared secret checked by src/app/api/revalidate/route.ts against the Sanity
# webhook's configured secret.
SANITY_REVALIDATE_SECRET=

# --- Added in step 8 (enquiry form) ------------------------------------------

# A SECOND Sanity dataset, created as PRIVATE, holding submitted enquiries.
# It must not be the content dataset: that one is public, and a public dataset
# answers `*[_type == "enquiry"]` for anyone who knows the project id — every
# name, email and personal circumstance the form ever collected. The dataset
# NAME is not a secret; the dataset's own access setting is what protects it.
NEXT_PUBLIC_SANITY_ENQUIRIES_DATASET=enquiries

# Server-only token with write access to the dataset above. Needed at runtime
# by src/app/api/enquiry/route.ts — unlike the seeding scripts, this one
# cannot be created, used and deleted.
SANITY_API_WRITE_TOKEN=

# Mailbox for the enquiry notifications, on Hostinger's relay. The host, port
# and TLS setting are not here on purpose — they are fixed facts about that
# relay rather than secrets, so they live in src/lib/enquiry/sender.ts where
# they cannot drift out of sync with the host's own settings. Only the
# credentials vary per environment.
#
# Both the From address and the recipient are this same mailbox. Without
# these two the site still takes enquiries and still stores them — only the
# notification is lost, and the log says so by name.
EMAIL_USER=
EMAIL_PASSWORD=
